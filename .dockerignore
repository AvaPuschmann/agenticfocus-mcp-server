# Skip files irrelevant for the Docker build context.
# Same spirit as .gitignore but Docker-specific.

# Dependencies (installed fresh inside the image)
node_modules
npm-debug.log*

# Build output (regenerated by the builder stage)
dist

# Local secrets — must never enter the image
.env
.env.*
!.env.example

# Git
.git
.gitignore
.gitattributes

# CI / tooling
.github

# Tests (kept out of prod image)
**/*.test.ts
**/*.spec.ts
coverage

# Docs (small but unnecessary in the image — README stays for clarity)
# README.md  ← keep this one
LICENSE
docs

# Editor / OS
.vscode
.idea
.DS_Store
Thumbs.db

# Local dev only
docker-compose.yml
docker-compose.*.yml
.dockerignore
Dockerfile

# Python sibling project — not needed
python-port

# Test client (not needed in container)
test-client.mjs
