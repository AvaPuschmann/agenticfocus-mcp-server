# AgenticFocus MCP — env PRODUCTION (Story 25-4).
# Copier en `.env` sur le VPS (à côté de docker-compose.prod.yml) et remplir.
# NE PAS committer le .env réel (secrets).

# Projet Supabase (mêmes valeurs que l'app desktop/mobile)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Secret JWT Supabase — Supabase Studio → Project Settings → API → JWT Secret
# Requis pour valider les tokens des requêtes HTTP (auth user-scoped, Story 25-2)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# Transport HTTP en prod (déjà forcé par le compose, ici pour mémoire)
TRANSPORT=http
PORT=3000
