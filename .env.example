# AgenticFocus MCP Server — env vars template
# Copy this file to .env.docker (gitignored) and fill in real values.
# Story 25-3 Sprint 24 Epic 25.

# Required for both stdio and http modes
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Required for HTTP transport only (multi-user JWT auth)
# Find in Supabase Studio → Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret-here

# Optional
TRANSPORT=http      # http (default, recommended) | stdio (legacy single-user)
PORT=3000           # listen port for HTTP transport

# Legacy stdio mode ONLY — single user via env vars (not used in container)
# SUPABASE_USER_JWT=eyJ...
# USER_ID=d9dd9a28-ec9c-4a67-9253-f673021c1611
